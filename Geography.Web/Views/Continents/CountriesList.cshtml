@model IEnumerable<CountryViewModel>

@{
    ViewData["Title"] = "Local Counties";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Countries</h1>
            <p class="text-muted mb-0">
                Overview of countries and their geographical information.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">
                @(Model?.Count() ?? 0) countries
            </span>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold">
                    Country list
                </h5>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Country Code</th>
                        <th scope="col">ISO Code</th>
                        <th scope="col">Country</th>
                        <th scope="col">Currency</th>
                        <th scope="col">Continent</th>
                        <th scope="col">Population</th>
                        <th scope="col">Area (km²)</th>
                        <th scope="col">Capital</th>
                        <th scope="col">Mountains</th>
                        <th scope="col">Rivers</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var country in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @country.CountryCode
                                    </span>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @country.IsoCode
                                    </span>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @country.CountryName
                                    </div>
                                </td>

                                <td>
                                    @if (country.CurrencyCodeNavigation != null)
                                    {
                                        <span>
                                            @country.CurrencyCodeNavigation.CurrencyCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (country.ContinentCodeNavigation != null)
                                    {
                                        <span>
                                            @country.ContinentCodeNavigation.ContinentName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @country.ContinentCode
                                        </span>
                                    }
                                </td>

                                <td>
                                    @country.Population.ToString("N0")
                                </td>

                                <td>
                                    @country.AreaInSqKm.ToString("N0")
                                </td>

                                <td>
                                    @country.Capital
                                </td>

                                <td>
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                        @(country.Mountains?.Count ?? 0)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                        @(country.Rivers?.Count ?? 0)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">
                                    <div class="fs-1 mb-2">🌍</div>
                                    <h5>No countries found</h5>
                                    <p class="mb-0">
                                        There are currently no countries to display.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>